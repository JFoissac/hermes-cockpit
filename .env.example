# Hermes Cockpit — variables d'environnement
#
# Ce fichier ne contient AUCUN secret. Il documente les réglages optionnels.
# La clé de l'API Hermes n'est jamais copiée ici : le serveur la lit au runtime
# dans <HERMES_HOME>/.env (variable API_SERVER_KEY).

# Emplacement du Hermes home (state.db + .env)
# Windows par défaut : %LOCALAPPDATA%\hermes
# HERMES_HOME=C:/Users/<toi>/AppData/Local/hermes

# Base de l'API server Hermes
# HERMES_API_BASE=http://127.0.0.1:8642

# Port du service cockpit
# PORT=8791
